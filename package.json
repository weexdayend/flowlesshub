{
  "name": "flowlesshub",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.13.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm api:test",
    "api:generate": "pnpm --filter @flowlesshub/api-client generate",
    "api:run": "go -C services/api run ./cmd/api",
    "worker:run": "go -C services/api run ./cmd/worker",
    "api:test": "go -C services/api test ./...",
    "api:vet": "go -C services/api vet ./..."
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
