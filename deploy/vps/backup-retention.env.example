# Copy to /opt/flowlesshub/.vps-runtime/backup-retention.env on the VPS.
# Set mode 600. Dry-run policy is enabled with a keep floor of two; deletion remains disabled.
FLOWLESSHUB_BACKUP_RETENTION_ENABLED=1
FLOWLESSHUB_BACKUP_RETENTION_KEEP_LAST=2
FLOWLESSHUB_BACKUP_RETENTION_ALLOW_DELETE=0
FLOWLESSHUB_BACKUP_RETENTION_AUTO_PRUNE=0
