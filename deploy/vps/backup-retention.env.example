# Copy to /opt/flowlesshub/.vps-runtime/backup-retention.env on the VPS.
# Set mode 600. Defaults below are fail-closed: no automatic deletion.
FLOWLESSHUB_BACKUP_RETENTION_ENABLED=0
FLOWLESSHUB_BACKUP_RETENTION_KEEP_LAST=
FLOWLESSHUB_BACKUP_RETENTION_ALLOW_DELETE=0
FLOWLESSHUB_BACKUP_RETENTION_AUTO_PRUNE=0
