# Copy to .vps-runtime/.env on the VPS and chmod 600.
# Release tags must be commit-addressed sha-<40-character-commit-sha> tags from GHCR.
FLOWLESSHUB_GHCR_OWNER=weexdayend
FLOWLESSHUB_BLUE_RELEASE=sha-REPLACE_WITH_40_HEX_SHA
FLOWLESSHUB_GREEN_RELEASE=sha-REPLACE_WITH_40_HEX_SHA
FLOWLESSHUB_WORKER_RELEASE=sha-REPLACE_WITH_40_HEX_SHA
FLOWLESSHUB_MIGRATE_RELEASE=sha-REPLACE_WITH_40_HEX_SHA
FLOWLESSHUB_DB_NAME=flowlesshub
FLOWLESSHUB_DB_USER=flowlesshub
FLOWLESSHUB_DB_PASSWORD=REPLACE_WITH_64_HEX_CHAR_PASSWORD
FLOWLESSHUB_MIN_AVAILABLE_MIB=384
