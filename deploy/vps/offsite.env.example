# Copy to /opt/flowlesshub/.vps-runtime/offsite.env on the VPS.
# Set mode 600. Values must be populated only after an S3-compatible provider/bucket is approved.
# Restic repository encryption is controlled by a separate mode-600 password file.
FLOWLESSHUB_OFFSITE_ENABLED=0
RESTIC_REPOSITORY=s3:https://REPLACE_WITH_APPROVED_S3_ENDPOINT/REPLACE_WITH_BUCKET/flowlesshub
RESTIC_PASSWORD_FILE=/opt/flowlesshub/.vps-runtime/restic-password
AWS_ACCESS_KEY_ID=REPLACE_WITH_LIMITED_SCOPE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_LIMITED_SCOPE_SECRET_KEY
AWS_DEFAULT_REGION=REPLACE_WITH_REGION
