# Copy to /opt/flowlesshub/.vps-runtime/offsite.env on the VPS.
# Cloudflare R2 S3 API. Bucket: flowlesshub; repository prefix: flowlesshub.
# Set mode 600. Use a bucket-scoped R2 Object Read & Write Access Key ID/Secret Access Key.
# Revoke any credentials previously disclosed in chat. Restic password is a separate mode-600 file.
FLOWLESSHUB_OFFSITE_ENABLED=0
RESTIC_REPOSITORY=s3:https://1c963d68997150e20b9795c3e2de6b0b.r2.cloudflarestorage.com/flowlesshub/flowlesshub
RESTIC_PASSWORD_FILE=/opt/flowlesshub/.vps-runtime/restic-password
AWS_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
