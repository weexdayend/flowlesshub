header X-FlowlessHub-Active-Color {$FLOWLESSHUB_ACTIVE_COLOR}
header -Server

handle /_edge/livez {
  respond "ok" 200
}

handle /_edge/readyz {
  rewrite * /readyz
  reverse_proxy flowlesshub-api-{$FLOWLESSHUB_ACTIVE_COLOR}.flowlesshub.svc.cluster.local:80 {
    health_uri /readyz
    health_interval 5s
    health_timeout 3s
    health_fails 2
    health_passes 1
    lb_try_duration 5s
    transport http {
      dial_timeout 2s
      response_header_timeout 5s
    }
  }
}

@api path /api /api/*
handle @api {
  uri strip_prefix /api
  reverse_proxy flowlesshub-api-{$FLOWLESSHUB_ACTIVE_COLOR}.flowlesshub.svc.cluster.local:80 {
    health_uri /readyz
    health_interval 5s
    health_timeout 3s
    health_fails 2
    health_passes 1
    lb_try_duration 5s
    transport http {
      dial_timeout 2s
      response_header_timeout 30s
    }
  }
}

handle {
  reverse_proxy flowlesshub-web-{$FLOWLESSHUB_ACTIVE_COLOR}.flowlesshub.svc.cluster.local:80 {
    health_uri /
    health_interval 5s
    health_timeout 5s
    health_fails 2
    health_passes 1
    lb_try_duration 5s
    transport http {
      dial_timeout 2s
      response_header_timeout 30s
    }
  }
}
