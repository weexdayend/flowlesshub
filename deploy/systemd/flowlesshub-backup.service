[Unit]
Description=FlowlessHub PostgreSQL backup, off-site upload, and local retention review
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
OnSuccess=flowlesshub-backup-alert@success.service
OnFailure=flowlesshub-backup-alert@failure.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
WorkingDirectory=/opt/flowlesshub
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/tmp/flowlesshub-home
Environment=DOCKER_CONFIG=/tmp/flowlesshub-docker-config
# ProtectHome=true hides /home/ubuntu; keep Restic's ephemeral cache in the unit's private /tmp.
Environment=RESTIC_CACHE_DIR=/tmp/flowlesshub-restic-cache
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
ExecStartPre=/usr/bin/install -d -m 0700 /tmp/flowlesshub-home/.config/git /tmp/flowlesshub-docker-config
ExecStart=/opt/flowlesshub/scripts/vps/scheduled-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/flowlesshub/.vps-runtime
